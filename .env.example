# Copy to .env and fill in ONE provider. Never commit .env.
# With ATLAS_PROVIDER=auto (default) Atlas picks the provider from whichever key is set.

# --- Option A: Claude (Anthropic) --------------------------------------------
#ANTHROPIC_API_KEY=

# --- Option B: OpenAI ---------------------------------------------------------
# OPENAI_API_KEY=
# ATLAS_MODEL=gpt-5.5

# --- Option C: Google Gemini --------------------------------------------------
# GEMINI_API_KEY=
# ATLAS_MODEL=gemini-flash-latest

# --- Option D: local model (no key) -------------------------------------------
# ATLAS_PROVIDER=ollama          # http://localhost:11434/v1   (ollama pull qwen3:8b)
# ATLAS_MODEL=qwen3:8b
# ATLAS_PROVIDER=lmstudio        # http://localhost:1234/v1    (set ATLAS_MODEL to the loaded model id)
# ATLAS_PROVIDER=vllm            # http://localhost:8000/v1
# --- or any other OpenAI-compatible endpoint (llama.cpp, LocalAI, OpenRouter, Groq, ...)
# ATLAS_BASE_URL=http://localhost:8080/v1
# ATLAS_MODEL=my-model
# ATLAS_API_KEY=                 # only if the endpoint needs one

# --- Optional -----------------------------------------------------------------
# TAVILY_API_KEY=                # web search for non-Claude providers (Claude has hosted search)
# ATLAS_WORKER_MODEL=            # cheaper/faster model for specialist agents (default: ATLAS_MODEL)
# ATLAS_PRICE_INPUT_PER_MTOK=    # pricing for non-Claude models so cost budgets apply
# ATLAS_PRICE_OUTPUT_PER_MTOK=
# ATLAS_REASONING_EFFORT=auto    # auto | on | off  (OpenAI reasoning_effort)
# ATLAS_ORCHESTRATOR_EFFORT=high # low | medium | high | xhigh | max
# ATLAS_WORKER_EFFORT=medium
# ATLAS_MAX_TURNS=25
# ATLAS_MAX_COST_USD=5.00
# ATLAS_APPROVAL_MODE=ask        # ask | auto_approve | auto_deny
# ATLAS_DATA_DIR=.atlas
